# RAG Memory System 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# === API 配置 ===
# OpenAI兼容API密钥（用于rerank、embedding等）
MY_API_KEY=your_api_key_here

# API基础地址
MY_API_BASE=https://api.example.com/v1

# 聊天模型名称（与embedding/rerank分开）
MY_MODEL=Qwen3-32B-FP8

# === Milvus 向量数据库配置 ===
# Milvus主机地址
MILVUS_HOST=localhost

# Milvus端口
MILVUS_PORT=19530

# === 可选配置 ===
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# 日志文件路径
# LOG_FILE=logs/memory_system.log

# 是否启用控制台日志
# LOG_CONSOLE=true

# === 高级配置 ===
# Embedding模型名称（覆盖config.py中的默认值）
# EMBEDDING_MODEL=bge-m3

# Rerank模型名称（覆盖config.py中的默认值）
# RERANK_MODEL=bge-reranker-large

# 向量检索权重（0.0-1.0）
# VECTOR_WEIGHT=0.7

# BM25检索权重（0.0-1.0）
# BM25_WEIGHT=0.3